VITE_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY

# reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# Site key is public (used in the browser). The SECRET key must NOT go here —
# it lives only in the Supabase Edge Function:
#   supabase secrets set RECAPTCHA_SECRET_KEY=<your-secret>
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Supabase — https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key (seed script only — NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
